diff --git a/pyproject.toml b/pyproject.toml
index e1722c6..361f0e2 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -132,6 +132,7 @@ testpaths = [
 ]
 markers = [
     "skip_in_parallel: test cannot be run under multi-rank MPI",
+    "postprocess: test is a post-processing script that is not run by default",
 ]
 
 [[tool.mypy.overrides]]
diff --git a/tests/test_cli_postprocess.py b/tests/test_cli_postprocess.py
index fabc236..1ea15b0 100644
--- a/tests/test_cli_postprocess.py
+++ b/tests/test_cli_postprocess.py
